---
import Base from '../layouts/Base.astro';
import { business } from '../data/business';
import { u } from '../lib/url';
---
<Base title="Page not found" description="That page does not exist on rdinnovate.com.">
<section class="hero">
  <div class="wrap">
    <p class="eyebrow">404</p>
    <h1>That page isn't here.</h1>
    <p class="lede">The link may be from our old website. Everything now lives on one page,
    and our research news is on the blog.</p>
    <div class="btns">
      <a class="btn btn-primary" href={u('/')}>Home</a>
      <a class="btn btn-ghost" href={business.links.blog}>Breaking R&amp;D News &rarr;</a>
    </div>
  </div>
</section>
</Base>

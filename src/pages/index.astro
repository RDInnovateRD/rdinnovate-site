---
// Home page. Layout, copy and assets follow the one.com page it replaces:
// title strip, chart-artwork hero with a translucent panel, About with the
// video, and a maroon contact section. "Latest from the desk" and the
// Software strip are additions.
import Base from '../layouts/Base.astro';
import { business } from '../data/business';
import { latestArticles, displayDate } from '../lib/latest';
import { u } from '../lib/url';

const latest = await latestArticles(3);
---
<Base>
<section class="title-strip">
  <div class="wrap">
    <h1>R&amp;D Innovate</h1>
    <p class="subtitle">Dare to Dream, Innovate and Disrupt</p>
  </div>
</section>

<section class="hero" style={`background-image:url('${u('/media/hero-background.jpg')}')`}>
  <div class="hero-box">
    <p>At R&amp;D Innovate, we are dedicated to helping businesses maximize their innovation potential through
    expert guidance and support.</p>
    <p>We view R&amp;D as essential for business success and partner closely with clients to navigate the
    complexities of bringing new ideas to market. Our tailored solutions are designed to meet each client's
    unique needs and goals. We prioritize understanding your challenges to ensure your success.</p>
    <p>Contact us today to explore how we can assist you.</p>
  </div>
  <div class="btn-row"><a class="btn" href={u('/#contact')}>Contact Us</a></div>
</section>

<section class="block panel" id="about">
  <div class="wrap about">
    <div>
      <h2>Driving Innovation Through Research</h2>
      <p>R&amp;D Innovate is a trusted partner in helping clients bring their innovation visions to life. We
      understand that the journey from a research question to a commercialized product is complex and fraught
      with challenges. That's why we provide comprehensive support throughout the entire innovation lifecycle.
      If you are looking for a partner to help you bring your innovation vision to life, then R&amp;D Innovate
      is the right choice for you. Contact us today to learn more about our services and how we can help you
      achieve your innovation goals.</p>
    </div>
    <figure class="video">
      <video id="aboutVideo" muted playsinline controls preload="metadata" controlslist="nodownload"
             poster={u('/media/rdinnovate-video-poster.jpg')} width="960" height="540">
        <source src={u('/media/rdinnovate-video.mp4')} type="video/mp4">
      </video>
    </figure>
  </div>
  <script is:inline>
  // Plays (muted) when scrolled into view and pauses when scrolled away, like the
  // one.com autoplay. Stays still for reduced-motion or data-saver visitors.
  (function () {
    var v = document.getElementById('aboutVideo');
    if (!v || !('IntersectionObserver' in window)) return;
    var calm = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    var saver = navigator.connection && navigator.connection.saveData;
    if (calm || saver) return;
    var userPaused = false;
    v.addEventListener('pause', function () { if (!v.dataset.auto) userPaused = true; delete v.dataset.auto; });
    new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (e.isIntersecting && !userPaused) { v.play().catch(function () {}); }
        else if (!e.isIntersecting && !v.paused) { v.dataset.auto = '1'; v.pause(); }
      });
    }, { threshold: 0.5 }).observe(v);
  })();
  </script>
</section>

{latest.length > 0 && (
  <section class="block" aria-labelledby="latest-h">
    <div class="wrap">
      <div class="head-row">
        <h2 id="latest-h">Breaking R&amp;D News</h2>
        <a class="more-link" href={business.links.blog}>All articles &rarr;</a>
      </div>
      <div class="cards">
        {latest.map((a) => (
          <a class="card" href={a.url}>
            <span class="meta">{[a.category, displayDate(a.date)].filter(Boolean).join(' · ')}</span>
            <h3>{a.title}</h3>
            {a.summary && <p>{a.summary}</p>}
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<section class="block" aria-labelledby="soft-h">
  <div class="wrap">
    <div class="soft">
      <div>
        <p class="kicker">Software to prepare your R&amp;D Tax Incentive claim</p>
        <h2 id="soft-h">RnD Tax Workbench</h2>
        <p>Prepare Australian R&amp;D Tax Incentive claims on your own machine. Import your general ledger,
        payroll and timesheets, classify expenditure against Division 355, and produce a defensible schedule.</p>
      </div>
      <a class="app-download" href={business.links.software}>
        <img src={u('/media/rnd-tax-workbench-icon.png')} width="128" height="128"
             alt="RnD Tax Workbench icon" loading="lazy" decoding="async">
        <span>Download</span>
      </a>
    </div>
  </div>
</section>

<section class="contact" id="contact">
  <div class="wrap">
    <h2>Contact Us for Assistance</h2>
    {business.web3formsKey ? (
      <>
        <p>We are available to answer any questions and provide support. Complete the form below or mail us at</p>
        <p><a class="mail" href={`mailto:${business.email}`}>{business.email}</a></p>
        <form class="contact" id="contactForm" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value={business.web3formsKey}>
          <input type="hidden" name="subject" value="New enquiry from rdinnovate.com">
          <input type="hidden" name="from_name" value="rdinnovate.com">
          <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <div class="row">
            <label>Name *<input name="name" required autocomplete="name"></label>
            <label>Email *<input name="email" type="email" required autocomplete="email"></label>
          </div>
          <label>Message *<textarea name="message" required></textarea></label>
          <p class="fine">We use these details only to reply to you. See our <a href={u('/privacy/')}>privacy notice</a>.</p>
          <div class="actions"><button class="btn btn-light" type="submit">Send</button></div>
          <p class="status" id="formStatus" role="status" aria-live="polite"></p>
        </form>
        <script is:inline>
        (function () {
          var f = document.getElementById('contactForm'), s = document.getElementById('formStatus');
          if (!f || !window.fetch) return;
          f.addEventListener('submit', function (e) {
            e.preventDefault();
            s.textContent = 'Sending...';
            fetch(f.action, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(f) })
              .then(function (r) { return r.json(); })
              .then(function (d) {
                if (d.success) { f.reset(); s.textContent = 'Thank you. Your message has been sent.'; }
                else { s.textContent = 'That did not send. Please email us directly.'; }
              })
              .catch(function () { s.textContent = 'That did not send. Please email us directly.'; });
          });
        })();
        </script>
      </>
    ) : (
      <>
        <p>We are available to answer any questions and provide support. Mail us at</p>
        <p><a class="mail" href={`mailto:${business.email}`}>{business.email}</a></p>
        {business.phone && <p><a href={`tel:${business.phone.replace(/\s/g, '')}`}>{business.phone}</a></p>}
      </>
    )}
  </div>
</section>
</Base>
